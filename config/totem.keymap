#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
            &kp Q  &kp W  &kp E                 &kp R      &kp T    &kp Y  &kp U          &kp I                      &kp O    &kp P
            &kp A  &kp S  &kp D                 &kp F      &kp G    &kp H  &kp J          &kp K                      &kp L    &kp SEMICOLON
&kp ESCAPE  &kp Z  &kp X  &kp N9                &kp V      &kp B    &kp N  &kp M          &kp COMMA                  &kp DOT  &kp SLASH      &kp ENTER
                          &mt LEFT_CONTROL TAB  &kp SPACE  &to 1    &to 2  &kp BACKSPACE  &mt RIGHT_SHIFT RIGHT_WIN
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
             &none             &kp NUMBER_2  &kp UP_ARROW  &kp NUMBER_7  &kp RA(NUMBER_4)    &kp RA(EQUAL)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(EQUAL)
             &kp RA(NUMBER_0)  &kp LEFT      &kp DOWN      &kp RIGHT     &kp RA(NUMBER_5)    &kp RA(MINUS)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp NUMBER_6
&kp LA(TAB)  &none             &kp NUBS      &kp EQUAL     &kp LS(NUBS)  &kp NUMBER_5        &kp MINUS      &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(PERIOD)  &none
                                             &none         &none         &to 0               &to 2          &kp DELETE        &kp LS(NUMBER_0)
            >;
        };

        symbole {
            display-name = "Sym";
            bindings = <
                &kp NUMBER_0  &kp NUMBER_9  &kp APOS  &none  &kp RA(PERCENT)     &kp RA(EQUAL)  &kp SEMI               &kp NUMBER_1  &kp RA(NUMBER_8)  &kp RA(NUMBER_3)
                &none         &none         &none     &none  &kp RA(NUMBER_5)    &kp RA(MINUS)  &mt NUMBER_8 NUMBER_6  &kp NUMBER_6  &kp LS(PERIOD)    &kp RIGHT_BRACE
&studio_unlock  &none         &none         &none     &none  &kp NUMBER_5        &kp MINUS      &mt NUMBER_4 NUMBER_3  &kp NUMBER_3  &kp RA(NUMBER_7)  &kp LEFT_BRACE    &kp ESCAPE
                                            &trans    &none  &to 0               &to 3          &trans                 &trans
            >;
        };

        function_key {
            display-name = "fn";
            bindings = <
       &kp F1  &kp F2   &kp F3   &kp F4   &none    &trans  &trans  &trans  &trans  &trans
       &kp F5  &kp F6   &kp F7   &kp F8   &none    &trans  &trans  &trans  &trans  &trans
&none  &kp F9  &kp F10  &kp F11  &kp F12  &none    &trans  &trans  &trans  &trans  &trans  &trans
                        &none    &none    &to 0    &trans  &trans  &trans
            >;
        };

        Gaming {
            display-name = "Game";
            bindings = <
            &kp Z           &kp X  &kp C      &kp V         &sl 5     &trans  &trans  &trans  &trans  &trans
            &kp TAB         &kp Q  &kp W      &kp E         &kp R     &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_SHIFT  &kp A  &kp S      &kp D         &kp F     &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp LCTRL  &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;
        };

        Gaming+ {
            display-name = "Game+";
            bindings = <
        &kp F10  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp T     &kp RA(RC(Y))  &kp RA(RC(U))  &trans  &trans  &kp LC(RA(DEL))
        &kp L    &kp O         &kp Y         &kp K         &kp G     &kp F5         &kp F7         &trans  &trans  &kp F12
&trans  &to 0    &trans        &trans        &trans        &trans    &trans         &trans         &trans  &trans  &kp F22          &kp LA(F4)
                               &kp J         &kp I         &kp M     &trans         &trans         &trans
            >;
        };
    };
};
